{
  "name": "@reearth/sentinel",
  "version": "0.1.2",
  "description": "Service worker library for secure asset access with transparent authentication",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./sw": "./dist/sw.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:sw",
    "build:lib": "tsc --project tsconfig.lib.json",
    "build:sw": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run type-check && npm test && npm run clean && npm run build"
  },
  "keywords": [
    "service-worker",
    "asset-security",
    "authentication",
    "proxy",
    "bearer-token",
    "cache",
    "pwa",
    "secure-assets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reearth/sentinel.git"
  },
  "homepage": "https://github.com/reearth/sentinel#readme",
  "bugs": "https://github.com/reearth/sentinel/issues",
  "author": "Re:Earth Contributors",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "jose": "^5.0.0"
  },
  "peerDependencies": {},
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "npm@11.14.1"
}
