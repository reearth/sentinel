{
  "name": "sentinel-resium-tiles-example",
  "private": true,
  "type": "module",
  "scripts": {
    "tiles": "node server/tile-server.mjs",
    "app": "vite --port 5173 --strictPort",
    "dev": "concurrently -k -n tiles,app \"npm:tiles\" \"npm:app\"",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "playwright test"
  },
  "dependencies": {
    "@reearth/sentinel": "file:../..",
    "cesium": "^1.147.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resium": "^1.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
